# Required for secure login sessions in a production deployment.
# Generate a long random value, for example: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Required on Vercel so user accounts and appointments persist across requests.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/physio-therapy

# Optional. Use a comma-separated list when the frontend is hosted elsewhere.
# CORS_ORIGIN=https://your-domain.example
